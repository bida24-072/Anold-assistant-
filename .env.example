# ============================================================
# ANOLD ASSISTANT — Environment Configuration
# Copy this file to `.env` and fill in real values.
# Never commit your real `.env` file.
# ============================================================

# --- Gemini (cloud LLM brain) -------------------------------
# Get a key from https://aistudio.google.com/app/apikey
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL_FLASH=gemini-2.5-flash
EXPO_PUBLIC_GEMINI_MODEL_PRO=gemini-2.5-pro

# --- Picovoice Porcupine (wake word) ------------------------
# Get an AccessKey from https://console.picovoice.ai/
# Then train a custom "Hey Anold" wake word (.ppn file) in the
# Porcupine console for BOTH Android and iOS platforms, and
# place the resulting files at:
#   assets/wakeword/hey-anold-android.ppn
#   assets/wakeword/hey-anold-ios.ppn
EXPO_PUBLIC_PICOVOICE_ACCESS_KEY=

# --- Local LLM (offline hybrid mode) ------------------------
# Path (relative to app document directory after download) to a
# quantized GGUF model, e.g. a Q4_K_M 1B-3B instruct model.
# Recommended starting point: Llama-3.2-3B-Instruct-Q4_K_M.gguf
# or Qwen2.5-1.5B-Instruct-Q4_K_M.gguf for faster on-device speed.
EXPO_PUBLIC_LOCAL_MODEL_FILENAME=local-model.Q4_K_M.gguf
EXPO_PUBLIC_LOCAL_MODEL_DOWNLOAD_URL=

# --- Whisper (offline STT) ----------------------------------
# whisper-tiny or whisper-base tflite model, quantized.
EXPO_PUBLIC_WHISPER_MODEL_FILENAME=whisper-tiny.en.tflite

# --- Assistant identity --------------------------------------
EXPO_PUBLIC_ASSISTANT_NAME=Anold
EXPO_PUBLIC_WAKE_PHRASE=Hey Anold
